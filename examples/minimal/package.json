{
  "name": "minimal",
  "version": "0.0.1",
  "description": "Minimal NestJS SSR React example with HMR support",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm build:client && cp src/views/index.html dist/client/ && pnpm build:server && nest build",
    "build:client": "vite build --ssrManifest --outDir dist/client",
    "build:server": "vite build --ssr src/views/entry-server.tsx --outDir dist/server",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "NODE_ENV=production node dist/main",
    "start:dev": "concurrently --raw -n vite,nest -c cyan,green \"pnpm:dev:vite\" \"pnpm:dev:nest\"",
    "dev:vite": "vite",
    "dev:nest": "NODE_ENV=development nestjs-ssr dev --watchAssets",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs-ssr/react": "link:../../packages/react",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "http-proxy-middleware": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.13",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
