{
  "name": "@nestjs-ssr/monorepo",
  "version": "0.1.0",
  "description": "NestJS SSR React - Monorepo containing package and examples",
  "author": "Georgi Alexandrov",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "pnpm build:package && pnpm --filter minimal build",
    "build:package": "pnpm --filter @nestjs-ssr/react build",
    "dev:minimal": "pnpm --filter minimal start:dev",
    "dev:full": "pnpm --filter full-featured-example start:dev",
    "test": "pnpm -r test",
    "test:package": "pnpm --filter @nestjs-ssr/react test",
    "lint": "oxlint --type-aware",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files",
    "security:check": "node scripts/security-check.mjs",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo",
    "typecheck": "pnpm -r typecheck",
    "changelog": "changelogen",
    "release": "changelogen --release",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "lefthook install",
    "format:check": "prettier --check \"packages/react/src/**/*.{ts,tsx}\" \"packages/react/test/**/*.ts\""
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@size-limit/file": "13.0.3",
    "changelogen": "0.6.2",
    "dependency-cruiser": "18.3.1",
    "knip": "6.37.0",
    "lefthook": "2.1.14",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.8",
    "size-limit": "13.0.3",
    "typescript": "7.0.2",
    "vitepress": "1.6.4"
  },
  "engines": {
    "node": "^22.15.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=12.0.0 <13.0.0"
  },
  "packageManager": "pnpm@12.6.0",
  "dependencies": {
    "@nestjs-ssr/react": "link:packages/react"
  }
}
