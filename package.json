{
  "name": "@nestjs-ssr/monorepo",
  "version": "0.1.0",
  "description": "NestJS SSR React - Monorepo containing package and examples",
  "author": "Georgi Alexandrov",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "build:package": "pnpm --filter @nestjs-ssr/react build",
    "dev:minimal": "pnpm --filter minimal start:dev",
    "dev:full": "pnpm --filter full-featured-example start:dev",
    "test": "pnpm -r test",
    "test:package": "pnpm --filter @nestjs-ssr/react test",
    "lint": "eslint \"packages/**/*.ts\" \"examples/**/*.ts\" --fix",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files",
    "security:check": "node scripts/security-check.mjs",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo",
    "typecheck": "pnpm -r typecheck",
    "changelog": "changelogen",
    "release": "changelogen --release",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^13.0.3",
    "changelogen": "^0.6.2",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "knip": "^6.32.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "size-limit": "^13.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": "^22.15.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "packageManager": "pnpm@10.34.4",
  "dependencies": {
    "@nestjs-ssr/react": "link:packages/react"
  }
}
